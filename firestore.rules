rules_version = '2';
// 家庭記帳本 Firestore 安全規則
// 個人資料：只有本人能讀寫。家庭資料：只有成員能讀寫；要加入家庭必須持有有效的邀請連結。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hh(hid) { return /databases/$(database)/documents/households/$(hid); }
    function isMember(hid) { return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)); }
    function isOwner(hid) { return signedIn() && get(hh(hid)).data.owner == request.auth.uid; }

    // 每個人自己的帳、照片、生日名單、設定
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read: if isMember(hid);
      // 成員可以改名字、存錢目標；只有擁有者可以把擁有者轉給別人
      allow update: if isMember(hid) && (request.resource.data.owner == resource.data.owner || resource.data.owner == request.auth.uid);
      allow delete: if isOwner(hid);

      match /members/{uid} {
        allow read: if isMember(hid);
        // 建立家庭的人把自己加進來；其他人要帶著有效的邀請碼才能加入
        allow create: if signedIn() && request.auth.uid == uid && (
          getAfter(hh(hid)).data.owner == uid ||
          (request.resource.data.invite is string &&
           exists(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.invite)) &&
           get(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.invite)).data.expiresAt > request.time)
        );
        allow update: if signedIn() && request.auth.uid == uid && request.resource.data.invite == resource.data.invite;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(hid));
      }

      // 邀請碼：拿到連結的人可以讀（看家的名字），成員可以產生和停用
      match /invites/{token} {
        allow get: if signedIn();
        allow list: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.by == request.auth.uid && request.resource.data.expiresAt is timestamp;
        allow delete: if isMember(hid);
      }

      // 每個人分享給家人看的摘要
      match /shares/{uid} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && request.auth.uid == uid;
        allow delete: if isMember(hid) && (request.auth.uid == uid || isOwner(hid));
      }

      // 家庭存錢目標的存入紀錄
      match /contrib/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember(hid) && (resource.data.uid == request.auth.uid || isOwner(hid));
      }

      // 全家的帳
      match /ledgers/{lid}/{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    // 意見回饋：只能寫，不能讀（到 Firebase 主控台看）
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
    }
  }
}
